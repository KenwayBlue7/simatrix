{"nodes": [{"id": "decisions_adr_log", "label": "DECISIONS.md \u2014 Simatrix ADR Log", "file_type": "document", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_001", "label": "ADR-001: No Build Step; Pinned CDN ES Modules (three@0.160.0)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-contained payloads must run with zero toolchain, work offline after the first CDN fetch, and stay reproducible via a pinned version; a build step breaks the open-the-folder-and-it-runs contract."}, {"id": "decisions_adr_002", "label": "ADR-002: Host Integration via window.simAPI, not postMessage", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The sim is only the iframe payload; a tiny synchronous pause/resume/reset API plus a static meta.json is the smallest possible host contract, needing no message protocol or origin negotiation."}, {"id": "decisions_adr_003", "label": "ADR-003: CSS Design Tokens as Single Runtime Source of Truth", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One source of truth means viewport linework and UI chrome can never disagree on a colour; a re-theme is a token swap, not a code hunt."}, {"id": "decisions_adr_004", "label": "ADR-004: Single rebuild() Pipeline for Every Geometry Change", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents WebGL context exhaustion (the most likely late-stage bug) by funneling all disposal through one disciplined point, and guarantees scene/projections/labels/self-check always reflect one state."}, {"id": "decisions_adr_005", "label": "ADR-005: Re-derive Ported Signs Visually; Explicit ZXY Euler Order", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unity is left-handed, Three.js right-handed; copying signs verbatim produces plausible-but-wrong mirrored projections, so signs are re-derived against a worked example and the Euler order is pinned to ZXY."}, {"id": "decisions_adr_006", "label": "ADR-006: Fat Lines + Hard-Edge Geometry + Edge Welding", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LineBasicMaterial caps at 1px on most GPUs, but engineering line weights must be real pixels; welding collapses duplicate edges so a cylinder rim isn't drawn as a double line."}, {"id": "decisions_adr_007", "label": "ADR-007: Orchestrator + Leaf Modules (leaves don't cross-import; only genericSolid shared)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A strict no-cross-import rule keeps the dependency graph a star hanging off the orchestrator, so a leaf can be read/replaced without tracing sibling webs."}, {"id": "decisions_adr_008", "label": "ADR-008: Rotation Priority Hierarchy via Mutually-Exclusive UI", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rotation modes can conflict; a strict UI-enforced precedence prevents contradictory states and teaches concepts in order (pentagonal preset is 54\u00b0, not 18\u00b0)."}, {"id": "decisions_adr_009", "label": "ADR-009: No Shared Library \u2014 Topic Clones are Manual Copies of Module 2", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With no build/package manager there is no place for a shared library; full duplication keeps each topic standalone and lets a clone drop features safely, at the known cost that copies will drift."}, {"id": "decisions_adr_010", "label": "ADR-010: DESIGN.shared.md Duplicated Per Module (Superseded by ADR-022)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_011", "label": "ADR-011: Module 1 Shared engine.js + Thin Pages (Superseded by ADR-033)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven copy-pasted pages had drifted; lifting all real logic into one shared engine means a change lands once and pages can no longer drift. Later fully superseded once the orchestrator pattern was adopted platform-wide."}, {"id": "decisions_adr_012", "label": "ADR-012: On-demand Compare View Replaces Persistent Dual-Pane", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_013", "label": "ADR-013: The Fold Camera Moves (overturns 'camera never moves during fold')", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_014", "label": "ADR-014: Auto-zoom One-shot Eased Dolly; Tight-fit XOR Push-back", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_015", "label": "ADR-015: Self-check \u00b10.5-tolerant, Never Auto-fills", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-filling would defeat the teaching; a limitation the student can see and manipulate teaches the distinction. OR-arrays accept only genuinely degenerate cases."}, {"id": "decisions_adr_016", "label": "ADR-016: Drawing Line Conventions follow N.D. Bhatt / ISO", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_017", "label": "ADR-017: Lines Sim is a 5-step Problem-solving Stepper", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_018", "label": "ADR-018: Textbook Fidelity; 1 world unit = 10 mm scale", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_019", "label": "ADR-019: Headless Verification via Node built-in WebSocket CDP (no puppeteer)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installing puppeteer would violate the no-build contract; Node's built-in WebSocket makes a dependency unnecessary, and the final check must run the shipped module, not a replica."}, {"id": "decisions_adr_020", "label": "ADR-020: Naming \u2014 'Simple Positions' No Topic Number; Folder Names Hide Master", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_021", "label": "ADR-021: Lines Compare Workbench (collapse wizard, dock live params)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_022", "label": "ADR-022: Design System Centralized into one Root DESIGN.md", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The root now exists and the two DESIGN.shared.md copies had drifted ~2 lines; one root file removes the drift surface entirely and doubled as a code-audit correctness pass."}, {"id": "decisions_adr_023", "label": "ADR-023: PRODUCT.md Centralized into one Root File", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_024", "label": "ADR-024: Topic Folder Naming graphics_module_M_topic_K_slug", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_025", "label": "ADR-025: New Subject Picks Template by Geometry (Module 2 for 3D, Module 1 for 2D)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_026", "label": "ADR-026: index.html <title> Must Match meta.json title", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_027", "label": "ADR-027: iShape.js is an Adapt File, Not Copy-identical", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_028", "label": "ADR-028: A New Topic Consumes the Root DESIGN.md/PRODUCT.md", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_029", "label": "ADR-029: Foundations Topic \u2014 Orchestrator + Line-of-sight Hidden-line Classifier", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teaching line types on an orbitable non-convex 3D bearing block makes edge visibility camera-dependent; Module 2's convex worldNormal shortcut fails, so a per-edge raycast occlusion classifier is required."}, {"id": "decisions_adr_030", "label": "ADR-030: three-mesh-bvh via CDN Import Map to Accelerate Occlusion Raycasting", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A BVH turns each ray from O(triangles) into ~O(log triangles), making per-frame re-classification affordable; it ships as an ES module pinnable in the same import map, so it stays inside the no-build contract."}, {"id": "decisions_adr_031", "label": "ADR-031: Real-time rAF Throttling Replaces the Occlusion Debounce", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_032", "label": "ADR-032: Floating Padded Scrollbar Pill (tinted to --color-border)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_adr_033", "label": "ADR-033: Module 1 Fully Adopts Orchestrator Pattern (fully supersedes ADR-011)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running two rendering architectures for the same product was an unreconciled known issue; standardizing the whole platform on the orchestrator pattern removes that cognitive tax rather than leaving Foundations a one-off."}, {"id": "decisions_adr_034", "label": "ADR-034: Points Compare Card draws 2D on a Canvas2D, not a Second WebGL Stack", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A finished point sheet is a handful of primitives; a second WebGLRenderer would double GL contexts in the iframe for that, and context exhaustion is the platform's most likely late-stage bug."}], "edges": [{"source": "decisions_adr_022", "target": "decisions_adr_010", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "source_location": null, "weight": 1.0}, {"source": "decisions_adr_033", "target": "decisions_adr_011", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "source_location": null, "weight": 1.0}, {"source": "decisions_adr_029", "target": "decisions_adr_011", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "source_location": null, "weight": 1.0}, {"source": "decisions_adr_029", "target": "decisions_adr_007", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "source_location": null, "weight": 1.0}, {"source": "decisions_adr_029", "target": "decisions_adr_006", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DECISIONS.md", "source_location": null, "weight": 1.0}, {"source": "decisions_adr_030", "target": "decisions_adr_029", "relation": "references", "confid